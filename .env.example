# NURE Dataset Generator - Environment Configuration

# ──────────────────────────────────────────────
# Firebase Configuration
# ──────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ──────────────────────────────────────────────
# Dataset Output Configuration
# ──────────────────────────────────────────────
DATASET_ROOT=./dataset
PRODUCTS_DIR=./dataset/products
REPORTS_DIR=./dataset/reports
LOGS_DIR=./dataset/logs
FIRESTORE_EXPORT_DIR=./dataset/firestore_export

# ──────────────────────────────────────────────
# Scraping Configuration
# ──────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=2.0
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# ──────────────────────────────────────────────
# Image Quality Thresholds
# ──────────────────────────────────────────────
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200
MAX_ASPECT_RATIO=5.0
BLUR_THRESHOLD=100.0
MIN_IMAGES_PER_PRODUCT=10
TARGET_IMAGES_PER_PRODUCT=25

# ──────────────────────────────────────────────
# Open Food Facts API
# ──────────────────────────────────────────────
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/cgi/search.pl
OPENFOODFACTS_APP_NAME=NURE-Dataset-Builder
OPENFOODFACTS_APP_VERSION=1.0.0

# ──────────────────────────────────────────────
# Proxy Configuration (Optional)
# ──────────────────────────────────────────────
USE_PROXY=false
PROXY_URL=

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_ROTATION=100MB
